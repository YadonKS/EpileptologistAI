# Copy this file to .env and replace placeholders with real values.
# Do NOT commit .env files containing secrets.

# Postgres/Supabase connection string for direct DB scripts and Express API
DATABASE_URL=postgresql://postgres:password@db.host:5432/postgres

# Supabase REST roundtrip script inputs
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE=your_service_role_key

# Optional API port override
PORT=3001
